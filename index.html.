<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>COLD BLOOD × PASS REAPERS | AZL / AZL ATELIER</title>
  <style>
    :root {
      --bg: #08090c;
      --panel: #10131a;
      --panel-2: #161b25;
      --line: rgba(255, 255, 255, 0.09);
      --text: #f3f5f8;
      --muted: #98a2b3;
      --accent: #ef233c;
      --accent-2: #38bdf8;
      --amber: #f59e0b;
      --ok: #22c55e;
      --radius: 16px;
    }

    * {
      box-sizing: border-box;
    }

    html, body {
      margin: 0;
      padding: 0;
      background: radial-gradient(circle at top, #151924 0%, var(--bg) 58%);
      color: var(--text);
      font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      min-height: 100vh;
    }

    .wrap {
      max-width: 1120px;
      margin: 0 auto;
      padding: 16px 14px 56px;
    }

    .topbar {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      background: var(--panel);
      border: 1px solid var(--line);
      border-radius: var(--radius);
      padding: 14px;
      margin-bottom: 14px;
    }

    .brand-left {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .mode-switch {
      display: flex;
      gap: 6px;
    }

    .mode-btn {
      width: 44px;
      height: 44px;
      border-radius: 12px;
      border: 1px solid var(--line);
      background: var(--panel-2);
      color: var(--text);
      font-weight: 800;
      cursor: pointer;
      transition: 0.15s ease;
    }

    .mode-btn.active {
      background: var(--accent);
      border-color: var(--accent);
      color: #fff;
    }

    .title-group h1 {
      margin: 0;
      font-size: 18px;
      letter-spacing: 0.04em;
      text-transform: uppercase;
    }

    .badge-row {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 8px;
      margin-top: 6px;
      font-size: 12px;
      color: var(--muted);
    }

    .tag {
      padding: 3px 8px;
      border-radius: 999px;
      background: rgba(239, 35, 60, 0.16);
      border: 1px solid rgba(239, 35, 60, 0.35);
      color: #ffd6dc;
      font-weight: 700;
      letter-spacing: 0.04em;
    }

    .actions {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }

    .btn {
      border: 1px solid var(--line);
      background: var(--panel-2);
      color: var(--text);
      padding: 10px 14px;
      border-radius: 12px;
      font-weight: 700;
      font-size: 13px;
      cursor: pointer;
      transition: 0.15s ease;
    }

    .btn:hover {
      border-color: rgba(255, 255, 255, 0.24);
    }

    .btn.primary {
      background: var(--accent);
      border-color: var(--accent);
      color: #fff;
    }

    .btn.active {
      background: var(--accent);
      border-color: var(--accent);
      color: #fff;
    }

    .nav-tabs {
      display: flex;
      gap: 8px;
      overflow-x: auto;
      padding-bottom: 4px;
      margin-bottom: 16px;
    }

    .tab-btn {
      white-space: nowrap;
      border: 1px solid var(--line);
      background: var(--panel);
      color: var(--muted);
      padding: 9px 14px;
      border-radius: 12px;
      font-weight: 700;
      font-size: 12px;
      letter-spacing: 0.04em;
      cursor: pointer;
    }

    .tab-btn.active {
      background: var(--panel-2);
      color: var(--text);
      border-color: var(--accent);
    }

    .section {
      background: var(--panel);
      border: 1px solid var(--line);
      border-radius: var(--radius);
      padding: 16px;
      margin-bottom: 16px;
    }

    .section-kicker {
      font-size: 11px;
      font-weight: 800;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--accent);
      margin-bottom: 4px;
    }

    .section-title {
      margin: 0 0 12px;
      font-size: 20px;
    }

    .grid-2 {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(290px, 1fr));
      gap: 14px;
    }

    .grid-3 {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 14px;
    }

    .card {
      background: var(--panel-2);
      border: 1px solid var(--line);
      border-radius: 14px;
      padding: 14px;
    }

    canvas {
      width: 100%;
      display: block;
      background: #0b0e14;
      border: 1px solid var(--line);
      border-radius: 12px;
    }

    .telemetry-strip {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
      gap: 10px;
      margin-top: 12px;
    }

    .stat-box {
      background: #0d1017;
      border: 1px solid var(--line);
      border-radius: 10px;
      padding: 10px;
    }

    .stat-label {
      font-size: 11px;
      color: var(--muted);
      text-transform: uppercase;
    }

    .stat-val {
      font-size: 16px;
      font-weight: 800;
      margin-top: 3px;
    }

    .view-bar {
      display: flex;
      gap: 6px;
      margin: 10px 0;
    }

    .view-chip {
      border: 1px solid var(--line);
      background: #0d1017;
      color: var(--muted);
      padding: 5px 10px;
      border-radius: 8px;
      font-size: 12px;
      font-weight: 700;
      cursor: pointer;
    }

    .view-chip.active {
      background: rgba(56, 189, 248, 0.16);
      border-color: var(--accent-2);
      color: #e0f2fe;
    }

    .car-stage {
      position: relative;
      background: #0b0e14;
      border: 1px solid var(--line);
      border-radius: 12px;
      padding: 10px;
      min-height: 126px;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
    }

    .car-stage svg {
      width: 100%;
      max-height: 112px;
    }

    .hud-overlay {
      position: absolute;
      inset: 8px;
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      pointer-events: none;
      font-size: 11px;
      font-weight: 700;
      color: #e2e8f0;
      text-shadow: 0 1px 4px #000;
    }

    .pill-list {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      margin: 10px 0;
    }

